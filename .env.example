# =============================================================================
# Solver-MCP MCP Connector — environment template
#
# `make env` copies this file verbatim to .env (only if .env does not exist).
# Fill in the REQUIRED values below before running.
#
# IMPORTANT formatting rules (pydantic-settings parses this file literally):
#   - Never put a comment on the same line as KEY=value.
#   - Variables with a default value are set explicitly below.
#   - Secret / credential placeholders are left COMMENTED on purpose: an empty
#     value (KEY=) is the string "" — NOT "unset" — and would pass the
#     "is it set?" check, so the app would start with a broken credential
#     instead of failing fast. Uncomment a secret only when you give it a value.
#
# Every variable maps 1:1 to a field in config/settings.py.
# =============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────
# LLM provider: one of openai, anthropic, azure, ollama, google_genai
LLM_PROVIDER=anthropic

# ── Provider credentials — uncomment and fill the block matching LLM_PROVIDER ─
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic / Claude
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-01

# Ollama (local, no key needed)
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini  (set LLM_PROVIDER=google_genai)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── MCP transport (stdio for the Prototype; http needs MCP_API_KEY) ─────────
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://localhost:8000
# MCP_API_KEY=

# ── Redis (Compose also sets REDIS_URL for in-stack services) ────────────────
REDIS_URL=redis://redis-svc:6379/0
CELERY_BROKER_URL=redis://redis-svc:6379/0
CELERY_RESULT_BACKEND=redis://redis-svc:6379/0

# ── Artifact store ──────────────────────────────────────────────────────────
ARTIFACT_STORE_TYPE=local
LOCAL_ARTIFACT_PATH=/artifacts
# S3 — required only when ARTIFACT_STORE_TYPE=s3 (keep commented until set)
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Authentication (secrets; keep commented until set) ──────────────────────
# API_KEY=
# JWT_SECRET=

# ── Solver shared volume ────────────────────────────────────────────────────
WORK_DIR=/work

# ── Solver runner (how the worker invokes solvers) ──────────────────────────
RUNNER_BACKEND=docker
OPENFOAM_CONTAINER=Solver-MCP-openfoam
OPENFOAM_BASHRC=/opt/openfoam10/etc/bashrc
LAMMPS_CONTAINER=Solver-MCP-lammps
LAMMPS_BINARY=lmp_serial

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
CORRELATION_ID_HEADER=X-Correlation-ID

# ── Observability — LangSmith tracing (optional; off by default) ────────────
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Solver-MCP

# ── Server bind ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Gunicorn (read by run-fastapi-server.sh) ────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
